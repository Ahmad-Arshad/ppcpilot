cat > .gitignore << 'EOF'
# Environment files
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local

# Python
backend/venv/
backend/__pycache__/
backend/.pytest_cache/
backend/.mypy_cache/
*.pyc
*.pyo
*.pyd
.Python

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# Database / uploads
*.sqlite3
*.db
uploads/
storage/

# OS / IDE
.DS_Store
.idea/
.vscode/

# Docker
*.log
EOF